  },
  {
   "fieldname": "customer_vehicle",
   "fieldtype": "Link",
   "label": "Customer Vehicle",
   "options": "Customer Vehicle",
   "read_only": 1,
   "fetch_from": "repair_job.customer_vehicle"
  },
  {
   "fieldname": "context_column_break",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "workshop_bay",
   "fieldtype": "Link",
   "label": "Workshop Bay",
   "options": "Workshop Bay",
   "fetch_from": "repair_job.workshop_bay",
   "in_list_view": 1
  },
  {
   "fieldname": "diagnosis_report",
