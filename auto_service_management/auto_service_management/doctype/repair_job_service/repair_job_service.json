  {
   "role": "Service Advisor",
   "read": 1,
   "report": 1,
   "write": 1,
   "create": 1
  },
  {
   "role": "Parts Interpreter",
   "read": 1,
   "report": 1,
   "write": 1
  },
  {
   "role": "Workshop Technician",
   "read": 1,
   "write": 1
  },
  {
   "role": "Cashier",
   "read": 1,
   "report": 1
  }
 ],
