{
 "align_labels_right": 0,
 "custom_format": 1,
 "default_print_language": "en",
 "disabled": 0,
 "doc_type": "Repair Job",
 "docstatus": 0,
 "doctype": "Print Format",
 "font": "Default",
 "html": "<style>\n.print-heading { border-bottom: 2px solid #1f2937; margin-bottom: 14px; padding-bottom: 8px; }\n.meta { width: 100%; margin-bottom: 12px; }\n.meta td { padding: 4px 6px; vertical-align: top; }\n.lines { width: 100%; border-collapse: collapse; }\n.lines th, .lines td { border: 1px solid #d1d5db; padding: 5px; }\n.signature { margin-top: 28px; border-top: 1px solid #111827; padding-top: 4px; width: 42%; }\n</style>\n<div class=\"print-heading\"><h2>Job Card {{ doc.name }}</h2></div>\n<table class=\"meta\"><tr><td><b>Customer:</b> {{ doc.customer }}</td><td><b>Vehicle:</b> {{ doc.customer_vehicle }}</td></tr><tr><td><b>Status:</b> {{ doc.job_status }}</td><td><b>Promised:</b> {{ frappe.utils.format_datetime(doc.promised_date) if doc.promised_date else \"\" }}</td></tr></table>\n<p><b>Customer concern</b></p><div>{{ doc.customer_concern or \"\" }}</div>\n<table class=\"lines\"><thead><tr><th>Type</th><th>Description</th><th>Technician</th><th>Status</th></tr></thead><tbody>{% for row in doc.service_lines %}<tr><td>{{ row.service_type }}</td><td>{{ row.service_description }}</td><td>{{ row.assigned_to or \"\" }}</td><td>{{ row.status }}</td></tr>{% endfor %}</tbody></table>\n<div class=\"signature\">Technician signature</div>",
 "line_breaks": 0,
 "module": "Auto Service Management",
 "name": "Job Card",
 "print_format_builder": 0,
 "print_format_type": "Jinja",
 "show_section_headings": 0,
 "standard": "Yes"
}
