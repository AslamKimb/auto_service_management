{
 "align_labels_right": 0,
 "custom_format": 1,
 "default_print_language": "en",
 "disabled": 0,
 "doc_type": "Walkaround Inspection",
 "docstatus": 0,
 "doctype": "Print Format",
 "font": "Default",
 "html": "<style>\n.print-heading { border-bottom: 2px solid #1f2937; margin-bottom: 14px; padding-bottom: 8px; }\n.meta { width: 100%; margin-bottom: 12px; }\n.meta td { padding: 4px 6px; vertical-align: top; }\n.lines { width: 100%; border-collapse: collapse; }\n.lines th, .lines td { border: 1px solid #d1d5db; padding: 5px; }\n.signature { margin-top: 28px; border-top: 1px solid #111827; padding-top: 4px; width: 42%; }\n.vehicle-silhouette { width: 88%; height: 220px; margin: 0 auto 14px; position: relative; background: #f4f6f8; border-radius: 18px; overflow: hidden; }\n.vehicle-body { position: absolute; left: 16%; right: 16%; top: 38%; height: 24%; background: #1f2937; border-radius: 48px 52px 20px 20px; }\n.vehicle-cabin { position: absolute; left: 31%; right: 31%; top: 23%; height: 20%; background: #374151; border-radius: 40px 40px 10px 10px; }\n.vehicle-window { position: absolute; top: 28%; width: 14%; height: 12%; background: #e5e7eb; border-radius: 10px; }\n.vehicle-window.left { left: 37%; }\n.vehicle-window.right { right: 37%; }\n.vehicle-wheel { position: absolute; bottom: 10%; width: 12%; aspect-ratio: 1; background: #111827; border-radius: 999px; }\n.vehicle-wheel::after { content: \"\"; position: absolute; inset: 22%; background: #d1d5db; border-radius: 999px; }\n.vehicle-wheel.front { left: 23%; }\n.vehicle-wheel.rear { right: 23%; }\n</style>\n<div class=\"print-heading\"><h2>Walkaround Inspection {{ doc.name }}</h2></div>\n<table class=\"meta\"><tr><td><b>Repair Job:</b> {{ doc.repair_job }}</td><td><b>Vehicle:</b> {{ doc.customer_vehicle }}</td></tr><tr><td><b>Odometer:</b> {{ doc.odometer_reading }}</td><td><b>Fuel:</b> {{ doc.fuel_level or \"\" }}</td></tr></table>\n<div class=\"vehicle-silhouette\" aria-label=\"Vehicle silhouette\"><div class=\"vehicle-cabin\"></div><div class=\"vehicle-window left\"></div><div class=\"vehicle-window right\"></div><div class=\"vehicle-body\"></div><div class=\"vehicle-wheel front\"></div><div class=\"vehicle-wheel rear\"></div></div>\n<table class=\"lines\"><thead><tr><th>#</th><th>Area</th><th>Damage</th><th>Notes</th></tr></thead><tbody>{% for mark in doc.damage_marks %}<tr><td>{{ loop.index }}</td><td>{{ mark.vehicle_area or \"\" }}</td><td>{{ mark.damage_type or \"\" }}</td><td>{{ mark.notes or \"\" }}</td></tr>{% endfor %}</tbody></table>\n<div>{% for photo in [doc.inspection_photo_1, doc.inspection_photo_2, doc.inspection_photo_3] if photo %}<img src=\"{{ photo }}\" style=\"width:30%;margin:1%\">{% endfor %}</div>\n<p><small>I confirm that the recorded condition and numbered damage references were reviewed at intake.</small></p>\n{% if doc.customer_signature %}<img src=\"{{ doc.customer_signature }}\" style=\"max-height:80px\">{% endif %}<div class=\"signature\">Customer signature</div>",
 "line_breaks": 0,
 "module": "Auto Service Management",
 "name": "Walkaround Inspection",
 "print_format_builder": 0,
 "print_format_type": "Jinja",
 "show_section_headings": 0,
 "standard": "Yes"
}
