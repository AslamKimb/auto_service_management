{
 "name": "Repair Job",
 "module": "Auto Service Management",
 "doctype": "DocType",
 "document_type": "Document",
 "engine": "InnoDB",
 "autoname": "format:RJ-{YYYY}-{#####}",
 "track_changes": 1,
 "is_submittable": 0,
 "fields": [
  {
   "fieldname": "customer_section",
   "fieldtype": "Section Break",
   "label": "Customer and Vehicle"
  },
  {
   "fieldname": "customer",
   "fieldtype": "Link",
   "label": "Customer",
   "options": "Customer"
  },
  {
   "fieldname": "customer_vehicle",
   "fieldtype": "Link",
   "label": "Customer Vehicle",
   "options": "Customer Vehicle",
   "reqd": 1
  },
  {
   "fieldname": "column_break_customer",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "registration_number",
   "fieldtype": "Data",
   "label": "Registration Number",
   "fetch_from": "customer_vehicle.registration_number",
   "read_only": 1
  },
  {
   "fieldname": "vehicle_details",
   "fieldtype": "Small Text",
   "label": "Vehicle",
   "read_only": 1
  },
  {
   "fieldname": "job_card_snapshot",
   "fieldtype": "Long Text",
   "label": "Job Card Snapshot",
   "read_only": 1,
   "hidden": 1,
   "no_copy": 1
  },
  {
   "fieldname": "repair_job_id_html",
   "fieldtype": "HTML",
   "label": "Repair Job ID"
  },
  {
   "label": "Odometer In (km)",
   "fieldtype": "Float",
   "fieldname": "odometer_in",
   "reqd": 1
  },
  {
   "fieldname": "fuel_level",
   "fieldtype": "Select",
   "label": "Fuel Level",
   "options": "\nEmpty\n1/4\n1/2\n3/4\nFull"
  },
  {
   "fieldname": "job_section",
   "fieldtype": "Section Break",
   "label": "Job Details"
  },
  {
   "fieldname": "scope_revision",
   "fieldtype": "Int",
   "label": "Scope Revision",
   "default": 0,
   "read_only": 1
  },
  {
   "fieldname": "job_status",
   "fieldtype": "Select",
   "label": "Status",
    "options": "\nDraft\nAssessment\nAwaiting Approval\nIn Repair\nQuality Check\nBilling\nReady for Release\nClosed\nCancelled",
   "default": "Draft",
   "in_list_view": 1
  },
  {
   "fieldname": "priority",
   "fieldtype": "Select",
   "label": "Priority",
   "options": "\nLow\nNormal\nHigh\nUrgent",
   "default": "Normal"
  },
  {
   "fieldname": "column_break_job",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "promised_date",
   "fieldtype": "Datetime",
   "label": "Promised Date"
  },
  {
   "fieldname": "column_break_job2",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "project",
   "fieldtype": "Link",
   "label": "Project",
   "options": "Project",
   "read_only": 1
  },
  {
   "fieldname": "fleet_service_campaign",
   "fieldtype": "Link",
   "label": "Fleet Service Campaign",
   "options": "Fleet Service Campaign",
   "read_only": 1
  },
  {
   "fieldname": "quotation",
   "fieldtype": "Link",
   "label": "Quotation",
   "options": "Quotation",
   "read_only": 1
  },
  {
   "fieldname": "sales_order",
   "fieldtype": "Link",
   "label": "Sales Order",
   "options": "Sales Order",
   "read_only": 1
  },
  {
   "fieldname": "related_documents_section",
   "fieldtype": "Section Break",
   "label": "Related Documents",
   "collapsible": 1
  },
  {
   "fieldname": "walkaround_inspection",
   "fieldtype": "Link",
   "label": "Walkaround Inspection",
   "options": "Walkaround Inspection"
  },
  {
   "fieldname": "diagnosis_report",
   "fieldtype": "Link",
   "label": "Diagnosis Report",
   "options": "Diagnosis Report"
  },
  {
   "fieldname": "customer_authorization",
   "fieldtype": "Link",
   "label": "Customer Authorization",
   "options": "Customer Authorization"
  },
  {
   "fieldname": "quality_check",
   "fieldtype": "Link",
   "label": "Quality Check",
   "options": "Quality Check"
  },
  {
   "fieldname": "gate_pass",
   "fieldtype": "Link",
   "label": "Gate Pass",
   "options": "Gate Pass"
  },
  {
   "fieldname": "intake_notes_section",
   "fieldtype": "Section Break",
   "label": "Intake Notes",
   "collapsible": 1
  },
  {
   "fieldname": "column_break_related_documents",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "customer_concern",
   "fieldtype": "Text Editor",
   "label": "Customer Concern",
   "reqd": 1
  },
  {
   "fieldname": "services_section",
   "fieldtype": "Section Break",
   "label": "Services"
  },
  {
   "fieldname": "services_help",
   "fieldtype": "HTML",
   "label": "Services Help",
   "options": "<p class=\"text-muted\">Create customer-facing services from this job. Each service owns its parts, labour, consumables, and billing components.</p>"
  },
  {
   "fieldname": "total_amount",
   "fieldtype": "Currency",
   "label": "Total Amount",
   "options": "currency",
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "repair_job_services",
   "fieldtype": "Table",
   "label": "Repair Job Services",
   "options": "Repair Job Service Row"
  },
  {
   "fieldname": "sales_invoices",
   "fieldtype": "Table",
   "label": "Sales Invoices",
   "options": "Repair Job Invoice Row"
  },
  {
   "fieldname": "sales_orders",
   "fieldtype": "Table",
   "label": "Proforma Invoices (Sales Orders)",
   "options": "Repair Job Sales Order Row",
   "read_only": 1
  },
  {
   "fieldname": "payment_entries",
   "fieldtype": "Table",
   "label": "Payment Entries",
   "options": "Repair Job Payment Row"
  },
  {
   "fieldname": "currency",
   "fieldtype": "Link",
   "label": "Currency",
   "options": "Currency",
   "read_only": 1
  },
  {
   "fieldtype": "Section Break",
   "collapsible": 1,
   "label": "Billing and Release",
   "fieldname": "billing_section"
  },
  {
   "fieldname": "payment_status",
   "fieldtype": "Select",
   "label": "Payment Status",
   "options": "\nNot Invoiced\nUnpaid\nPartially Paid\nPaid",
   "default": "Not Invoiced"
  },
  {
   "fieldname": "billing_components_html",
   "fieldtype": "HTML",
   "label": "Component Billing Status"
  },
  {
   "fieldname": "sales_orders_html",
   "fieldtype": "HTML",
   "label": "Proforma Invoice Component Status"
  },
  {
   "fieldname": "material_requests_html",
   "fieldtype": "HTML",
   "label": "Material Request Status"
  },
  {
   "fieldname": "column_break_billing",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "odometer_out",
   "fieldtype": "Float",
   "label": "Odometer Out (km)"
  },
  {
   "fieldname": "closure_section",
   "fieldtype": "Section Break",
   "label": "Closure",
   "collapsible": 1
  },
  {
   "fieldname": "closed_on",
   "fieldtype": "Datetime",
   "label": "Closed On",
   "read_only": 1
  },
  {
   "fieldname": "closed_by",
   "fieldtype": "Link",
   "label": "Closed By",
   "options": "User",
   "read_only": 1
  },
  {
   "fieldname": "closure_type",
   "fieldtype": "Select",
   "label": "Closure Type",
   "options": "\nRepair Completed\nDiagnosis Only",
   "read_only": 1
  },
  {
   "fieldname": "payment_total",
   "fieldtype": "Currency",
   "label": "Payment Total",
   "options": "currency",
   "read_only": 1
  }
 ],
 "permissions": [
  {
   "role": "Workshop Manager",
   "read": 1,
   "report": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 0,
   "cancel": 0
  },
  {
   "role": "System Manager",
   "read": 1,
   "report": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 1,
   "cancel": 1,
   "amend": 1,
   "export": 1,
   "import": 1,
   "share": 1,
   "print": 1,
   "email": 1,
   "select": 1
  },
  {
   "role": "Service Advisor",
   "read": 1,
   "report": 1,
   "write": 1,
   "create": 1
  },
  {
   "role": "Parts Interpreter",
   "read": 1,
   "report": 1
  },
  {
   "role": "Cashier",
   "report": 1,
   "read": 1,
   "write": 0,
   "create": 0
  },
  {
   "role": "Workshop Technician",
   "read": 1,
   "write": 1
  },
  {
   "role": "Accounts Manager",
   "read": 1
  }
 ],
 "sort_field": "modified",
 "sort_order": "DESC",
 "title_field": "customer_vehicle",
 "search_fields": "customer_vehicle,registration_number,customer"
}
