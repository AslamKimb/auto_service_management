{
  "name": "Repair Service Template",
  "module": "Auto Service Management",
  "doctype": "DocType",
  "document_type": "Document",
  "engine": "InnoDB",
  "autoname": "field:template_name",
  "track_changes": 1,
  "fields": [
    {
      "fieldname": "template_section",
      "fieldtype": "Section Break",
      "label": "Template"
    },
    {
      "fieldname": "template_name",
      "fieldtype": "Data",
      "label": "Template Name",
      "reqd": 1,
      "unique": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "service_name",
      "fieldtype": "Data",
      "label": "Service Name",
      "reqd": 1
    },
    {
      "fieldname": "column_break_1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "default_billable",
      "fieldtype": "Check",
      "label": "Billable by Default",
      "default": 1
    },
    {
      "fieldname": "active",
      "fieldtype": "Check",
      "label": "Active",
      "default": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "description",
      "fieldtype": "Text Editor",
      "label": "Description"
    },
    {
      "fieldname": "components_section",
      "fieldtype": "Section Break",
      "label": "Default Components"
    },
    {
      "fieldname": "parts",
      "fieldtype": "Table",
      "label": "Default Parts",
      "options": "Repair Service Template Part"
    },
    {
      "fieldname": "labour",
      "fieldtype": "Table",
      "label": "Default Labour",
      "options": "Repair Service Template Labour"
    },
    {
      "fieldname": "consumables",
      "fieldtype": "Table",
      "label": "Default Consumables",
      "options": "Repair Service Template Consumable"
    },
    {
      "fieldname": "legacy_subcontracted_services",
      "fieldtype": "Table",
      "label": "Legacy Subcontracted Services",
      "options": "Repair Service Template Subcontracted Service",
      "hidden": 1,
      "read_only": 1,
      "no_copy": 1
    }
  ],
  "permissions": [
    {
      "role": "Workshop Manager",
      "read": 1,
      "report": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    },
    {
      "role": "Service Advisor",
      "read": 1,
      "report": 1,
      "write": 1,
      "create": 1
    },
    {
      "role": "Parts Interpreter",
      "read": 1,
      "report": 1,
      "write": 1,
      "create": 1
    }
  ],
  "sort_field": "modified",
  "sort_order": "DESC",
  "title_field": "service_name",
  "search_fields": "template_name,service_name"
}
