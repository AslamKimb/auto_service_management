{
 "name": "Customer Vehicle",
 "module": "Auto Service Management",
 "doctype": "DocType",
 "document_type": "Document",
 "engine": "InnoDB",
 "autoname": "format:{registration_number}",
 "track_changes": 1,
 "fields": [
  {
   "fieldname": "customer_section",
   "fieldtype": "Section Break",
   "label": "Customer"
  },
  {
   "fieldname": "customer",
   "fieldtype": "Link",
   "label": "Customer",
   "options": "Customer",
   "reqd": 1
  },
  {
   "fieldname": "column_break_customer",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "customer_name_display",
   "fieldtype": "Read Only",
   "label": "Customer Name",
   "fetch_from": "customer.customer_name"
  },
  {
   "fieldname": "vehicle_section",
   "fieldtype": "Section Break",
   "label": "Vehicle Details"
  },
  {
   "fieldname": "registration_number",
   "fieldtype": "Data",
   "label": "Registration Number",
   "reqd": 1,
   "unique": 1
  },
  {
   "fieldname": "column_break_vehicle",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "vin_chassis_number",
   "fieldtype": "Data",
   "label": "VIN / Chassis Number"
  },
  {
   "fieldname": "engine_number",
   "fieldtype": "Data",
   "label": "Engine Number"
  },
  {
   "fieldname": "column_break_vehicle2",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "make",
   "fieldtype": "Link",
   "label": "Make",
   "options": "Vehicle Make",
   "in_list_view": 1
  },
  {
   "fieldname": "model",
   "fieldtype": "Link",
   "label": "Model",
   "options": "Vehicle Model",
   "in_list_view": 1
  },
  {
   "fieldname": "column_break_vehicle3",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "year_of_manufacture",
   "fieldtype": "Int",
   "label": "Year of Manufacture"
  },
  {
   "fieldname": "color",
   "fieldtype": "Data",
   "label": "Color"
  },
  {
   "fieldname": "odometer_section",
   "fieldtype": "Section Break",
   "label": "Current Status"
  },
  {
   "fieldname": "current_odometer",
   "fieldtype": "Float",
   "label": "Current Odometer (km)"
  },
  {
   "fieldname": "column_break_odometer",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "last_service_date",
   "fieldtype": "Date",
   "label": "Last Service Date"
  },
  {
   "fieldname": "notes_section",
   "fieldtype": "Section Break",
   "label": "Notes",
   "collapsible": 1
  },
  {
   "fieldname": "vehicle_notes",
   "fieldtype": "Small Text",
   "label": "Notes"
  }
 ],
 "permissions": [
  {
   "role": "Workshop Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1
  },
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 1,
   "cancel": 1,
   "amend": 1,
   "report": 1,
   "export": 1,
   "import": 1,
   "share": 1,
   "print": 1,
   "email": 1,
   "select": 1
  },
  {
   "role": "Service Advisor",
   "read": 1,
   "write": 1,
   "create": 1
  },
  {
   "role": "Workshop Technician",
   "read": 1
  }
 ],
 "sort_field": "modified",
 "sort_order": "DESC",
 "title_field": "registration_number"
}
