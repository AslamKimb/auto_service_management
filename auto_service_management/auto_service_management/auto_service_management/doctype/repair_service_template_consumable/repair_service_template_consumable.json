{
  "name": "Repair Service Template Consumable",
  "module": "Auto Service Management",
  "doctype": "DocType",
  "document_type": "Document",
  "engine": "InnoDB",
  "istable": true,
  "editable_grid": 1,
  "fields": [
    {"fieldname": "description", "fieldtype": "Small Text", "label": "Description", "reqd": 1, "in_list_view": 1},
    {"fieldname": "item_code", "fieldtype": "Link", "label": "Item", "options": "Item", "reqd": 1, "in_list_view": 1},
    {"fieldname": "quantity", "fieldtype": "Float", "label": "Quantity", "default": 1, "in_list_view": 1},
    {"fieldname": "uom", "fieldtype": "Link", "label": "UOM", "options": "UOM"},
    {"fieldname": "warehouse", "fieldtype": "Link", "label": "Warehouse", "options": "Warehouse"},
    {"fieldname": "consumption_basis", "fieldtype": "Select", "label": "Consumption Basis", "options": "\nPer Job\nPer Quantity\nAs Used"},
    {"fieldname": "pricing_section", "fieldtype": "Section Break", "label": "Pricing"},
    {"fieldname": "rate", "fieldtype": "Currency", "label": "Rate"},
    {"fieldname": "cost_rate", "fieldtype": "Currency", "label": "Cost Rate"},
    {"fieldname": "billable", "fieldtype": "Check", "label": "Billable", "default": 1}
  ],
  "permissions": [
    {
      "role": "Workshop Manager",
      "read": 1,
      "report": 1
    },
    {
      "role": "Service Advisor",
      "read": 1,
      "report": 1
    },
    {
      "role": "Parts Interpreter",
      "read": 1,
      "report": 1
    }
  ],
  "sort_field": "modified",
  "sort_order": "DESC"
}
