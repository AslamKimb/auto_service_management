{
  "name": "Road Test Report",
  "module": "Auto Service Management",
  "doctype": "DocType",
  "document_type": "Document",
  "engine": "InnoDB",
  "autoname": "format:RT-{YYYY}-{#####}",
  "track_changes": 1,
  "fields": [
    {
      "fieldname": "test_section",
      "fieldtype": "Section Break",
      "label": "Road Test Details"
    },
    {
      "fieldname": "repair_job",
      "fieldtype": "Link",
      "label": "Repair Job",
      "options": "Repair Job",
      "reqd": 1
    },
    {
      "fieldname": "customer_vehicle",
      "fieldtype": "Link",
      "label": "Vehicle",
      "options": "Customer Vehicle",
      "reqd": 1
    },
    {
      "fieldname": "column_break_1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "test_date",
      "fieldtype": "Datetime",
      "label": "Test Date",
      "reqd": 1
    },
    {
      "fieldname": "tested_by",
      "fieldtype": "Link",
      "label": "Tested By",
      "options": "User",
      "reqd": 1
    },
    {
      "fieldname": "odometer_section",
      "fieldtype": "Section Break",
      "label": "Readings"
    },
    {
      "fieldname": "odometer_start",
      "fieldtype": "Float",
      "label": "Odometer Start (km)"
    },
    {
      "fieldname": "odometer_end",
      "fieldtype": "Float",
      "label": "Odometer End (km)"
    },
    {
      "fieldname": "column_break_2",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "route",
      "fieldtype": "Small Text",
      "label": "Test Route"
    },
    {
      "fieldname": "duration_minutes",
      "fieldtype": "Int",
      "label": "Duration (minutes)"
    },
    {
      "fieldname": "checks_section",
      "fieldtype": "Section Break",
      "label": "Performance Checks"
    },
    {
      "fieldname": "braking_ok",
      "fieldtype": "Check",
      "label": "Braking OK"
    },
    {
      "fieldname": "steering_ok",
      "fieldtype": "Check",
      "label": "Steering OK"
    },
    {
      "fieldname": "engine_performance_ok",
      "fieldtype": "Check",
      "label": "Engine Performance OK"
    },
    {
      "fieldname": "column_break_3",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "transmission_ok",
      "fieldtype": "Check",
      "label": "Transmission OK"
    },
    {
      "fieldname": "no_warning_lights",
      "fieldtype": "Check",
      "label": "No Warning Lights"
    },
    {
      "fieldname": "notes_section",
      "fieldtype": "Section Break",
      "label": "Notes",
      "collapsible": 1
    },
    {
      "fieldname": "test_notes",
      "fieldtype": "Text Editor",
      "label": "Notes"
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "options": "\nPending\nPassed\nFailed",
      "default": "Pending"
    }
  ],
  "permissions": [
    {
      "role": "Workshop Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    },
    {
      "role": "Workshop Technician",
      "read": 1,
      "write": 1,
      "create": 1
    }
  ],
  "sort_field": "modified",
  "sort_order": "DESC",
  "title_field": "repair_job"
}
