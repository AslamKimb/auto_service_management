{
  "name": "Walkaround Inspection",
  "module": "Auto Service Management",
  "doctype": "DocType",
  "document_type": "Document",
  "engine": "InnoDB",
  "autoname": "format:WI-{YYYY}-{#####}",
  "track_changes": 1,
  "is_submittable": 1,
  "fields": [
    {
      "fieldname": "inspection_section",
      "fieldtype": "Section Break",
      "label": "Inspection Details"
    },
    {
      "fieldname": "repair_job",
      "fieldtype": "Link",
      "label": "Repair Job",
      "options": "Repair Job",
      "reqd": 1
    },
    {
      "fieldname": "amended_from",
      "fieldtype": "Link",
      "label": "Amended From",
      "options": "Walkaround Inspection",
      "read_only": 1,
      "no_copy": 1,
      "hidden": 1
    },
    {
      "fieldname": "customer_vehicle",
      "fieldtype": "Link",
      "label": "Vehicle",
      "options": "Customer Vehicle",
      "reqd": 1,
      "fetch_from": "repair_job.customer_vehicle"
    },
    {
      "fieldname": "column_break_1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "inspection_date",
      "fieldtype": "Datetime",
      "label": "Inspection Date",
      "reqd": 1
    },
    {
      "fieldname": "inspected_by",
      "fieldtype": "Link",
      "label": "Inspected By",
      "options": "User",
      "reqd": 1
    },
    {
      "fieldname": "vehicle_section",
      "fieldtype": "Section Break",
      "label": "Vehicle Condition"
    },
    {
      "fieldname": "odometer_reading",
      "fieldtype": "Float",
      "label": "Odometer Reading (km)"
    },
    {
      "fieldname": "fuel_level",
      "fieldtype": "Select",
      "label": "Fuel Level",
      "options": "\nEmpty\n1/4\n1/2\n3/4\nFull"
    },
    {
      "fieldname": "column_break_2",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "overall_condition",
      "fieldtype": "Select",
      "label": "Overall Condition",
      "options": "\nGood\nFair\nPoor\nDamaged"
    },
    {
      "fieldname": "customer_present",
      "fieldtype": "Check",
      "label": "Customer Present"
    },
    {
      "fieldname": "damage_section",
      "fieldtype": "Section Break",
      "label": "Damage Marks"
    },
    {
      "fieldname": "damage_marks",
      "fieldtype": "Table",
      "label": "Damage Marks",
      "options": "Vehicle Damage Mark"
    },
    {
      "fieldname": "notes_section",
      "fieldtype": "Section Break",
      "label": "Notes",
      "collapsible": 1
    },
    {
      "fieldname": "condition_notes",
      "fieldtype": "Text Editor",
      "label": "Condition Notes"
    },
    {
      "fieldname": "customer_signature",
      "fieldtype": "Attach Image",
      "label": "Customer Signature"
    },
    {
      "fieldname": "photos_section",
      "fieldtype": "Section Break",
      "label": "Photos",
      "collapsible": 1
    },
    {
      "fieldname": "inspection_photo_1",
      "fieldtype": "Attach Image",
      "label": "Photo 1"
    },
    {
      "fieldname": "inspection_photo_2",
      "fieldtype": "Attach Image",
      "label": "Photo 2"
    },
    {
      "fieldname": "inspection_photo_3",
      "fieldtype": "Attach Image",
      "label": "Photo 3"
    }
  ],
  "permissions": [
    {
      "role": "Workshop Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "submit": 1,
      "cancel": 1,
      "amend": 1
    },
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "submit": 1,
      "cancel": 1,
      "amend": 1,
      "report": 1,
      "export": 1,
      "import": 1,
      "share": 1,
      "print": 1,
      "email": 1,
      "select": 1
    },
    {
      "role": "Service Advisor",
      "read": 1,
      "write": 1,
      "create": 1,
      "submit": 1
    },
    {
      "role": "Workshop Technician",
      "read": 1,
      "write": 1,
      "create": 1,
      "submit": 1
    }
  ],
  "sort_field": "modified",
  "sort_order": "DESC",
  "title_field": "repair_job"
}
