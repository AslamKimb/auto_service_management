{
  "name": "Fleet Service Campaign",
  "module": "Auto Service Management",
  "doctype": "DocType",
  "document_type": "Document",
  "engine": "InnoDB",
  "autoname": "format:FSC-{YYYY}-{#####}",
  "track_changes": 1,
  "fields": [
    {
      "fieldname": "campaign_section",
      "fieldtype": "Section Break",
      "label": "Campaign Details"
    },
    {
      "fieldname": "campaign_name",
      "fieldtype": "Data",
      "label": "Campaign Name",
      "reqd": 1
    },
    {
      "fieldname": "customer",
      "fieldtype": "Link",
      "label": "Customer",
      "options": "Customer",
      "reqd": 1
    },
    {
      "fieldname": "customer_lpo",
      "fieldtype": "Link",
      "label": "Customer LPO",
      "options": "Customer LPO",
      "read_only": 1
    },
    {
      "fieldname": "column_break_1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "campaign_start",
      "fieldtype": "Date",
      "label": "Campaign Start"
    },
    {
      "fieldname": "campaign_end",
      "fieldtype": "Date",
      "label": "Campaign End"
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "options": "\nDraft\nOngoing\nClosed\nCancelled",
      "default": "Draft"
    },
    {
      "fieldname": "description",
      "fieldtype": "Text Editor",
      "label": "Description"
    },
    {
      "fieldname": "jobs_section",
      "fieldtype": "Section Break",
      "label": "Repair Jobs"
    },
    {
      "fieldname": "fleet_jobs",
      "fieldtype": "Table",
      "label": "Repair Jobs",
      "options": "Fleet Service Campaign Job"
    },
    {
      "fieldname": "billing_section",
      "fieldtype": "Section Break",
      "label": "Campaign Billing"
    },
    {
      "fieldname": "sales_orders_html",
      "fieldtype": "HTML",
      "label": "Sales Orders"
    },
    {
      "fieldname": "sales_invoices_html",
      "fieldtype": "HTML",
      "label": "Sales Invoices"
    }
  ],
  "permissions": [
    {
      "role": "Workshop Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    },
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "submit": 1,
      "cancel": 1,
      "amend": 1,
      "report": 1,
      "export": 1,
      "import": 1,
      "share": 1,
      "print": 1,
      "email": 1,
      "select": 1
    },
    {
      "role": "Service Advisor",
      "read": 1,
      "write": 1,
      "create": 1
    }
  ],
  "sort_field": "modified",
  "sort_order": "DESC",
  "title_field": "campaign_name"
}
